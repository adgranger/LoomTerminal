<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Performance benchmarks (BenchmarkDotNet). Not run by `dotnet test`.
    Run: see docs/performance.md ("How to run").
  -->
  <PropertyGroup>
    <TargetFramework>$(LoomNetTargetFramework)</TargetFramework>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LoomTerminal.Core\LoomTerminal.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The recorded session replayed by ParseBenchmarks.RecordedGitLog. -->
    <None Include="..\LoomTerminal.Core.Tests\Conformance\Fixtures\recorded\git-log-graph.vtrec" Link="git-log-graph.vtrec" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
