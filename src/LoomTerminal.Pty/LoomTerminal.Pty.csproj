<Project Sdk="Microsoft.NET.Sdk">
  <!--
    LoomTerminal.Pty: starts a shell behind a pseudo terminal and moves bytes in both directions.
    RULE: no UI, no project references. Plain net11.0: platform code lives in a folder per OS (Windows/ = ConPTY)
    and is guarded by [SupportedOSPlatform] + OperatingSystem checks, so the package also loads on macOS and Linux.
  -->
  <PropertyGroup>
    <TargetFramework>$(LoomNetTargetFramework)</TargetFramework>
    <RootNamespace>LoomTerminal.Pty</RootNamespace>
    <Description>Pseudo terminal for LoomTerminal: Windows ConPTY (macOS and Linux planned), Native AOT-compatible.</Description>
    <!-- Source-generated [LibraryImport] stubs use pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LoomTerminal.Pty.Tests" />
  </ItemGroup>

  <!-- Projects that reference this one (tests, samples) get the shim of the machine they build on next to their output. -->
  <PropertyGroup>
    <LoomNativeOs Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux</LoomNativeOs>
    <LoomNativeOs Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx</LoomNativeOs>
    <LoomNativeArch>$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString().ToLowerInvariant())</LoomNativeArch>
  </PropertyGroup>

  <ItemGroup Condition="'$(LoomNativeOs)' != ''">
    <None Include="$(MSBuildThisFileDirectory)../../artifacts/native/$(LoomNativeOs)-$(LoomNativeArch)/libloomterm_pty.*" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Pack="false" Visible="false" />
  </ItemGroup>

  <!-- The Unix pty shim (src/native/pty/build.sh) is built per RID into artifacts/native/<rid>/; absent on Windows-only builds. -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../artifacts/native/linux-x64/libloomterm_pty.*" Pack="true" PackagePath="runtimes/linux-x64/native" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)../../artifacts/native/linux-arm64/libloomterm_pty.*" Pack="true" PackagePath="runtimes/linux-arm64/native" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)../../artifacts/native/osx-x64/libloomterm_pty.*" Pack="true" PackagePath="runtimes/osx-x64/native" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)../../artifacts/native/osx-arm64/libloomterm_pty.*" Pack="true" PackagePath="runtimes/osx-arm64/native" Visible="false" />
  </ItemGroup>
</Project>
