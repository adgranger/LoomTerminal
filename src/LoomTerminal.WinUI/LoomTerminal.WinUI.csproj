<Project Sdk="Microsoft.NET.Sdk">
  <!--
    LoomTerminal.WinUI: the public terminal control for WinUI 3 (main NuGet package) and its Win2D renderer.
    This is the ONLY project that knows about XAML, Win2D, input events and accessibility.
  -->
  <PropertyGroup>
    <TargetFramework>$(LoomWindowsTargetFramework)</TargetFramework>
    <TargetPlatformMinVersion>$(LoomWindowsMinVersion)</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <RootNamespace>LoomTerminal.WinUI</RootNamespace>
    <PackageId>LoomTerminal.WinUI</PackageId>
    <Description>LoomTerminal: a native, Native AOT-compatible terminal control for WinUI 3 (no WebView2).</Description>
    <!--
      Libraries are built AnyCPU. The native Microsoft.Graphics.Canvas.dll is copied by the *application*,
      which is always built for x64 or ARM64, so Win2D's AnyCPU warning does not apply here.
    -->
    <Win2DWarnNoPlatform>false</Win2DWarnNoPlatform>
    <!--
      RS0041: the XAML compiler generates a public XamlMetaDataProvider class without nullable annotations.
      We cannot change generated code; its members are still tracked in PublicAPI.Unshipped.txt.
    -->
    <NoWarn>$(NoWarn);RS0041</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Graphics.Win2D" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LoomTerminal.Presentation\LoomTerminal.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- MSBuild targets applied to apps that use the package (see the file for details). -->
    <None Include="buildTransitive\LoomTerminal.WinUI.targets" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>
</Project>
