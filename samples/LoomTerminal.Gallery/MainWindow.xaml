<Window
    x:Class="LoomTerminal.Gallery.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="LoomTerminal Gallery">

    <Grid ColumnDefinitions="*,Auto" RowDefinitions="*,Auto">
        <TabView
            x:Name="Tabs"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch"
            Grid.Column="0"
            IsAddTabButtonVisible="False"
            SelectionChanged="OnTabSelectionChanged"
            TabCloseRequested="OnTabCloseRequested">
            <TabView.TabStripFooter>
                <!-- Like Windows Terminal: "+" opens the last used shell, the chevron lists the shells. -->
                <StackPanel
                    x:Name="NewTabGroup"
                    Margin="4,0,0,4"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
                    <StackPanel.Resources>
                        <!-- Only the background changes on hover: no border, no divider. -->
                        <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                    </StackPanel.Resources>
                    <Button
                        Width="32"
                        Height="32"
                        Padding="0"
                        Click="OnNewTabClick"
                        ToolTipService.ToolTip="New tab">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                    </Button>
                    <Button
                        Width="32"
                        Height="32"
                        Padding="0"
                        Click="OnShellListClick"
                        ToolTipService.ToolTip="Choose a shell">
                        <FontIcon FontSize="10" Glyph="&#xE70D;" />
                    </Button>
                </StackPanel>
            </TabView.TabStripFooter>
        </TabView>

        <ScrollViewer Grid.Column="1" Width="240" Padding="12">
            <StackPanel Spacing="10">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Settings" />
                <ComboBox
                    x:Name="ThemeBox"
                    HorizontalAlignment="Stretch"
                    Header="Theme"
                    SelectedIndex="0"
                    SelectionChanged="OnSettingChanged">
                    <x:String>Dark (VS Code)</x:String>
                    <x:String>Light (VS Code)</x:String>
                    <x:String>Campbell (Windows Terminal)</x:String>
                </ComboBox>
                <TextBox
                    x:Name="BackgroundBox"
                    Header="Background override"
                    PlaceholderText="#0c0c0c"
                    TextChanged="OnSettingChanged" />
                <ComboBox
                    x:Name="FontFamilyBox"
                    HorizontalAlignment="Stretch"
                    Header="Font family"
                    SelectedIndex="0"
                    SelectionChanged="OnSettingChanged">
                    <x:String>Cascadia Mono</x:String>
                    <x:String>Cascadia Code</x:String>
                    <x:String>CaskaydiaCove Nerd Font</x:String>
                    <x:String>CaskaydiaCove Nerd Font Mono</x:String>
                    <x:String>Consolas</x:String>
                    <x:String>Courier New</x:String>
                </ComboBox>
                <ToggleSwitch
                    x:Name="WindowsTerminalFontSwitch"
                    Header="Font from Windows Terminal"
                    Toggled="OnWindowsTerminalFontToggled" />
                <Slider
                    x:Name="FontSizeSlider"
                    Header="Font size (pt)"
                    Maximum="24"
                    Minimum="6"
                    StepFrequency="1"
                    Value="12"
                    ValueChanged="OnSettingChanged" />
                <Slider
                    x:Name="LineHeightSlider"
                    Header="Line height"
                    Maximum="2"
                    Minimum="1"
                    StepFrequency="0.05"
                    Value="1.15"
                    ValueChanged="OnSettingChanged" />
                <ComboBox
                    x:Name="CursorStyleBox"
                    HorizontalAlignment="Stretch"
                    Header="Cursor style"
                    SelectedIndex="0"
                    SelectionChanged="OnSettingChanged">
                    <x:String>Block</x:String>
                    <x:String>Underline</x:String>
                    <x:String>Bar</x:String>
                </ComboBox>
                <ToggleSwitch
                    x:Name="BlinkSwitch"
                    Header="Cursor blink"
                    Toggled="OnSettingChanged" />
                <ToggleSwitch
                    x:Name="MeasureSwitch"
                    Header="Frame statistics"
                    Toggled="OnMeasureToggled" />
            </StackPanel>
        </ScrollViewer>

        <Border
            Grid.Row="1"
            Grid.ColumnSpan="2"
            Padding="12,4">
            <TextBlock x:Name="StatusText" Style="{StaticResource CaptionTextBlockStyle}" />
        </Border>
    </Grid>
</Window>
