<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Demo app for LoomTerminal. CI publishes it with Native AOT (PublishAot) and fails on any trimming/AOT warning:
    it is the proof that the whole chain WinUI -> Presentation -> Core (+ Pty) is AOT-safe.

    Build:    dotnet build samples/LoomTerminal.Gallery -p:Platform=x64
    Publish:  dotnet publish samples/LoomTerminal.Gallery -c Release -r win-x64
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(LoomWindowsTargetFramework)</TargetFramework>
    <TargetPlatformMinVersion>$(LoomWindowsMinVersion)</TargetPlatformMinVersion>
    <RootNamespace>LoomTerminal.Gallery</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- Unpackaged app (no MSIX) that carries the Windows App SDK runtime with it: just run the .exe. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Demos\*.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" LinkBase="Demos" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LoomTerminal.WinUI\LoomTerminal.WinUI.csproj" />
  </ItemGroup>

  <!--
    NuGet imports this file automatically for package consumers; a ProjectReference does not, so import it here.
    It contains the Native AOT publish workaround described in docs/adr/0001-baseline.md ("Known issues").
  -->
  <Import Project="..\..\src\LoomTerminal.WinUI\buildTransitive\LoomTerminal.WinUI.targets" />
</Project>
